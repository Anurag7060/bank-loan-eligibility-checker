# Loan-lead notifications. Copy this file to .env and fill in your mail provider's SMTP details.
RELATIONSHIP_MANAGER_EMAIL=anurag031208@gmail.com
# Legacy fallback name; use RELATIONSHIP_MANAGER_EMAIL for new setups.
OWNER_NOTIFICATION_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=Zenith Loan Portal <you@example.com>

# Required only for GET /api/v1/admin/summary. Use a long random value in any shared deployment.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Optional server settings
HOST=127.0.0.1
PORT=8080
# Optional: default is ./loan_portal.db
# DATABASE_PATH=./data/loan_portal.db
