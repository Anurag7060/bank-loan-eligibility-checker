# Brevo transactional email. Copy this file to .env, verify the sender in Brevo, then add an API key.
OWNER_NOTIFICATION_EMAIL=anuragsonwani73@gmail.com
BREVO_API_KEY=rxkeysib-7268b399581cb9c8c5be1926c84f7a493baf382aecdd621705c7045847dcb9bf-6ds4niO2XoiwS0wW
# The email address must be verified in Brevo Senders, Domains & Dedicated IPs.
BREVO_SENDER=Zenith Loan Portal <verified-sender@example.com>

# Used in the verification link sent after registration. Set this to the public HTTPS URL when deployed.
APP_BASE_URL=http://127.0.0.1:8080
# Set true only when the portal is served through HTTPS (recommended in production).
COOKIE_SECURE=false

# Required only for GET /api/v1/admin/summary. Use a long random value in any shared deployment.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Optional server settings
HOST=127.0.0.1
PORT=8080
# Optional: default is ./loan_portal.db
# DATABASE_PATH=./data/loan_portal.db
