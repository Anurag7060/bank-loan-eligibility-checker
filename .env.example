# ==============================================================================
# Zenith Bank - Loan Eligibility Checking System (LES)
# Environment Configuration (.env)
# ==============================================================================

# Server Port & Host
PORT=8080
HOST=0.0.0.0

# Admin Lead Notification Email (Enter your email here to receive all applicant leads)
ADMIN_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# Optional SMTP Server Settings (for live email delivery)
# ------------------------------------------------------------------------------

# Example 1: Gmail SMTP (Use an App Password generated in your Google Account security settings)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true
# SMTP_FROM="Zenith Bank Alerts <your-email@gmail.com>"

# Example 2: SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM="Zenith Bank Leads <leads@zenithbank.com>"

# Example 3: Microsoft Office 365 / Outlook
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your-account@domain.com
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true
